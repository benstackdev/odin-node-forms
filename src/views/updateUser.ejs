<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title %>
  </title>
</head>

<body>
  <h1>
    <%= title %>
  </h1>
  <%- include("./partials/errors.ejs") %>
    <form action="/<%= user.id %>/update" method="POST">
      <label for="firstName">*First name: </label>
      <input type="text" name="firstName" id="firstName" value="<%= user.firstName %>" required>
      <br>
      <label for="lastName">*Last name: </label>
      <input type="text" name="lastName" id="lastName" value="<%= user.lastName %>" required>
      <br>
      <label for="age">Age: </label>
      <input type="number" name="age" id="age" value="<%= user.age%>">
      <br>
      <label for="email">*Email: </label>
      <input type="email" name="email" id="email" value="<%= user.email %>" required>
      <br>
      <label for="bio">Brief bio: </label>
      <textarea name="bio" id="bio"><%= user.bio %></textarea>
      <br>
      <br>
      <button type="submit">Update user</button>
    </form>
    <a href="/">Back to user list</a>
</body>

</html>