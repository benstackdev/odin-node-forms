<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title %>
  </title>
</head>

<body>
  <h1>
    <%= title %>
  </h1>
  <ul>
    <% if (locals.users) { %>
      <% users.forEach((user)=> { %>
        <li>
          <div class="user-id">ID: <%= user.id %>
          </div>
          <div class="user-id">First name: <%= user.firstName %>
          </div>
          <div class="user-id">Last name: <%= user.lastName %>
          </div>
          <div class="user-id">age: <%= user.age %>
          </div>
          <div class="user-id">email: <%= user.email %>
          </div>
          <div class="user-id">bio: <%= user.bio %>
          </div>
        </li>
        <div class="user-update-link">
          <a href="/<%= user.id %>/update">Update</a>
        </div>
        <form action="/<%= user.id %>/delete" method="POST" style="display:inline;">
          <button type="submit" onclick="return confirm('Are you sure you want to delete this user?');">Delete</button>
        </form>
        <% }); %>
          <% } %>
  </ul>
  <a href="/create">Create new user</a>
  <br>
  <a href="/search">Search for existing user</a>
</body>

</html>